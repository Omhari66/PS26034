# pnpm configuration for PS 26034 monorepo
# Allow native build scripts (needed by React Native packages).
# pnpm v12 enforces an explicit allow-list; this enables all scripts.
# If stricter control is needed, list packages in pnpm.onlyBuiltDependencies
# in package.json (already set) — but pnpm v12.3 requires this flag too.
manage-package-manager-versions=false
