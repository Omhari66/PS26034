# Environment variables for PS 26034 backend
# Copy to .env and fill in real values — never commit .env

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/ps26034_dev

# JWT secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-before-any-real-use

# "dev" | "demo" — keep these separate, see ARCHITECTURE.md
ENVIRONMENT=dev
